# Configuration Environnement
ENVIRONMENT=production
PORT=8000

# Base de données (PostgreSQL sur votre serveur ou Railway)
DATABASE_URL=postgresql://scrivia_user:scrivia_secret_pass@localhost:5432/scrivia

# Anthropic Claude API (IA Générative)
ANTHROPIC_API_KEY=sk-ant-api03-...
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Cloudinary (Stockage sécurisé des fichiers générés)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Maketou (Paiements Mobile Money : Wave, Orange Money, MTN, Carte)
MAKETOU_API_KEY=your_maketou_api_key
MAKETOU_SECRET=your_maketou_webhook_secret
MAKETOU_BASE_URL=https://api.maketou.com/v1

# Optionnel : MongoDB & Cohere pour l'ancien assistant chat
MONGO_URI=mongodb+srv://...
MONGO_DB=portfolio
COHERE_API_KEY=...
